GEMINI_API_KEY=
BACKEND_URL=https://voiceai-hzyb.onrender.com

# Auth — both are optional overrides; defaults are set in server.ts
# AUTH_PASSWORD_HASH: sha256 of your chosen password (hex). Rotate without touching code.
#   node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')|console.log"
AUTH_PASSWORD_HASH=
# SESSION_SECRET: random 32-byte hex string. Set this so sessions survive server restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
