# ── Gemini ───────────────────────────────────────────────────────────────────
# One key for every channel: the kiosk (Live API) and WhatsApp (generateContent).
GEMINI_API_KEY=
# Optional override for the WhatsApp channel's model. Must be a model that
# supports REST generateContent — the kiosk's gemini-3.1-flash-live-preview is
# Live-API only and 404s here. Defaults to gemini-3.1-flash-lite.
WHATSAPP_GEMINI_MODEL=

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_URL=https://voiceai-hzyb.onrender.com

# ── Auth (legacy single-tenant — Savour Foods kiosk staff) ───────────────────
# SHA-256 of your chosen password (hex):
#   node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')|console.log"
AUTH_PASSWORD_HASH=
# Random 32-byte hex string (keeps legacy HMAC sessions stable across restarts):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Auth (multi-tenant JWT) ───────────────────────────────────────────────────
# Random 32-byte hex string — DIFFERENT from SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Super admin account (platform-wide, not a tenant) ────────────────────────
# If unset, super admin login is disabled.
# Email used to log in as super_admin:
SUPER_ADMIN_EMAIL=
# SHA-256 of the super admin password:
#   node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')|console.log"
SUPER_ADMIN_PASSWORD_HASH=

# ── Credential encryption ─────────────────────────────────────────────────────
# Random 32-byte hex string (exactly 64 hex chars) for AES-256-GCM:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# From: Upstash console → your database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
SUPABASE_URL=
# Use the SERVICE ROLE key (not anon) — server only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# From: Meta for Developers → your App → Settings → Basic → App Secret
META_APP_SECRET=
# System User token with whatsapp_business_messaging permission:
#   Meta Business Manager → System Users → Generate Token
META_WHATSAPP_TOKEN=
# Any string you choose — must match what you enter in Meta Developer Console → Webhooks → Verify Token
META_WEBHOOK_VERIFY_TOKEN=

# ── Paddle (billing) ──────────────────────────────────────────────────────────
# Which Paddle account the server talks to. "sandbox" or "production".
# Sandbox and production are SEPARATE accounts — a pro_/pri_/ctm_ id from one
# does not exist in the other. src/lib/paddle.ts refuses to start billing if the
# key prefix and this value disagree.
PADDLE_ENV=sandbox
# Server-side API key. NEVER exposed to the browser.
# From: Paddle → Developer tools → Authentication
#   sandbox keys start pdl_sdbx_apikey_..., live keys pdl_live_apikey_...
# Needs at least: product.read, price.read, customer.read, subscription.read,
# transaction.read, customer_portal_session.write, notification_setting.read
PADDLE_API_KEY=
# Signing secret for ONE notification destination — NOT the API key, and not
# interchangeable with it. Each destination has its own secret, shown once when
# you create it. Verifying with the wrong secret fails every delivery.
# From: Paddle → Developer tools → Notifications → your destination
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# Client-side token for Paddle.js in the browser. PUBLISHABLE — it can only open
# checkouts, never read or mutate account data, so shipping it to the browser is
# by design. Sandbox tokens start test_, live ones live_; the server refuses to
# serve one that disagrees with PADDLE_ENV.
# From: Paddle → Developer tools → Authentication → Client-side tokens
# (CLIENT is accepted as a fallback name.)
PADDLE_CLIENT_TOKEN=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Set to true in AI Studio / environments without HMR support
DISABLE_HMR=

# ── Phone channel (Asterisk + SIP trunk) ─────────────────────────────────────
# Off unless SIP_ENABLED=true. Needs an Asterisk instance registered to a SIP
# trunk — see telephony/sip/README-asterisk.md for the dialplan and pjsip config.
# The trunk MUST offer G.711 (alaw); G.729 is licensed and Asterisk will not
# transcode it, which presents as a connected call with total silence.
SIP_ENABLED=
ARI_URL=
ARI_USERNAME=
ARI_PASSWORD=
ARI_APP=
# Where our AudioSocket listens, and the host:port Asterisk dials back to.
# Keep them consistent; loopback is right when Asterisk is on the same host.
AUDIOSOCKET_PORT=
AUDIOSOCKET_ADDRESS=

# ── Local development / testing ───────────────────────────────────────────────
# In-memory stand-ins so the app boots with no Upstash or Supabase account.
# Never set these in production: mock stores lose everything on restart.
USE_MOCK_REDIS=
USE_MOCK_SUPABASE=

# Legacy alias for SUPABASE_SERVICE_ROLE_KEY, still read as a fallback by
# src/lib/supabaseAdmin.ts. Prefer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_KEY=

# Script-only. scripts/smoke.mts and the Paddle helpers read these; they have no
# effect on the running server.
SMOKE_BASE_URL=
SMOKE_TENANT_ID=
SEED_SLUG=
SEED_CURRENCY=
TEST_BASE_URL=
