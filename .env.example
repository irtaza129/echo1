# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_URL=https://voiceai-hzyb.onrender.com

# ── Auth (legacy single-tenant — Savour Foods kiosk staff) ───────────────────
# SHA-256 of your chosen password (hex):
#   node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')|console.log"
AUTH_PASSWORD_HASH=
# Random 32-byte hex string (keeps legacy HMAC sessions stable across restarts):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Auth (multi-tenant JWT) ───────────────────────────────────────────────────
# Random 32-byte hex string — DIFFERENT from SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Super admin account (platform-wide, not a tenant) ────────────────────────
# If unset, super admin login is disabled.
# Email used to log in as super_admin:
SUPER_ADMIN_EMAIL=
# SHA-256 of the super admin password:
#   node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')|console.log"
SUPER_ADMIN_PASSWORD_HASH=

# ── Credential encryption ─────────────────────────────────────────────────────
# Random 32-byte hex string (exactly 64 hex chars) for AES-256-GCM:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# From: Upstash console → your database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
SUPABASE_URL=
# Use the SERVICE ROLE key (not anon) — server only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# From: Meta for Developers → your App → Settings → Basic → App Secret
META_APP_SECRET=
# System User token with whatsapp_business_messaging permission:
#   Meta Business Manager → System Users → Generate Token
META_WHATSAPP_TOKEN=
# Any string you choose — must match what you enter in Meta Developer Console → Webhooks → Verify Token
META_WEBHOOK_VERIFY_TOKEN=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Set to true in AI Studio / environments without HMR support
DISABLE_HMR=
